# Grailio mainnet (BNB Smart Chain, chain 56). Copy to .env.local and fill in.
# Names only here: never commit real values.

# Privy app ID: sign-in with email, Google or a wallet, with a wallet made for
# people who don't have one. Free at https://dashboard.privy.io (enable BNB Smart
# Chain, add your domain to allowed origins). Without it, local dev falls back to a browser wallet.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: WalletConnect / Reown project ID for mobile wallet apps in Privy's list.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: your own BSC RPC instead of the public, rate-limited one.
# NEXT_PUBLIC_BSC_RPC_URL=

# Optional: the testnet app's URL, linked from the Testnet / Mainnet beta switch in the
# connect panel. Unset, the Testnet side shows as unavailable.
# NEXT_PUBLIC_TESTNET_URL=

# Deployed origin, for link previews (e.g. https://your-domain). Defaults to localhost.
# NEXT_PUBLIC_SITE_URL=

# Not needed by the app: activity and chat history read contract logs over public
# BSC RPCs (eth_getLogs) and cache them in the Upstash/KV store below. Only the
# contract verification script (contracts/script/verify.sh) uses an Etherscan key.
# ETHERSCAN_API_KEY=

# Server-only signing key. It holds REAL BNB: keep it in your host's secret store,
# never prefix it with NEXT_PUBLIC_, never commit it. Pays gas for chat posts and
# gift gas top-ups. Use a dedicated wallet holding only a little BNB.
# RELAYER_KEY=

# Relay spending limits (optional).
# RELAY_DAILY_LIMIT=
# RELAY_MAX_GWEI=
# GIFT_GAS_DAILY_LIMIT=

# Shared store for the relay's limits and send lock (required in production).
# Upstash Redis, or Vercel KV (KV_REST_API_URL / KV_REST_API_TOKEN also work).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RELAY_ALLOW_MEMORY_LIMITS=   # local testing only

# Beta gate for connecting wallets (server-only). Comma-separated codes.
# BETA_ACCESS_CODES=   # only if BETA_GATE_ON is true in lib/beta-gate.ts
# 16+ random characters that sign the access cookie (e.g. openssl rand -hex 32).
BETA_COOKIE_SECRET=
